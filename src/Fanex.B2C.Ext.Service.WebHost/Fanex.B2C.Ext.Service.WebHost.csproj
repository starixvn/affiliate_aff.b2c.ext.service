    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.15.1" />
    <PackageReference Include="ONEbook.UM.AspNetCore" Version="3.1.0" />
    <PackageReference Include="ONEbook.UM.Transport" Version="3.1.1" />
    <PackageReference Include="Sentry.AspNetCore" Version="3.21.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fanex.B2C.Ext.Service.Core\Fanex.B2C.Ext.Service.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="App_Data\SpConfig\SpName.xml">
